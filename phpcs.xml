<?xml version="1.0"?>
<ruleset name="Katherine Standard">
  <rule ref="PSR12"/>

  <!-- Override indentation to 2 spaces -->
  <rule ref="Generic.WhiteSpace.ScopeIndent">
    <properties>
      <property name="indent" value="2"/>
      <property name="tabIndent" value="false"/>
    </properties>
  </rule>
</ruleset>
