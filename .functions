# pixiekat-ytgrab — grab a youtube video by id, capped at a sane SD resolution.
#
# why 480 default: NTSC broadcast was ~480 visible lines, so for archival /
# broadcast-sourced material the source is usually <=480 anyway. capping here
# means we take the best *real* stream at or under our ceiling instead of
# downloading someone's baked-in upscale (bigger files, fake detail).
#
# usage: pixiekat-ytgrab <youtube_id> [max_height]
#        pixiekat-ytgrab dQw4w9WgXcQ        # caps at 480
#        pixiekat-ytgrab dQw4w9WgXcQ 360    # caps at 360
pixiekat-ytgrab() {
  local id="$1"
  local res="${2:-480}"   # default ceiling = 480; override as 2nd arg

  # --- help / usage -------------------------------------------------------
  if [[ "$id" == "--help" || "$id" == "--usage" ]]; then
    echo "Usage: pixiekat-ytgrab <youtube_id> [max_height]"
    echo "Example: pixiekat-ytgrab dQw4w9WgXcQ 480"
    echo ""
    echo "Env overrides:"
    echo "  YTGRAB_BROWSER   cookies-from-browser source (default: vivaldi)"
    echo "  YTGRAB_OUTDIR    output directory (default: current dir)"
    echo "  YTGRAB_ARCHIVE   download-archive file (default: ~/.local/share/pixiekat/ytgrab-archive.txt)"
    return 0
  fi

  # --- bail if no id ------------------------------------------------------
  if [ -z "$id" ]; then
    echo "Usage: pixiekat-ytgrab <youtube_id> [max_height]" >&2
    return 1
  fi

  local url="https://www.youtube.com/watch?v=$id"

  # --- configurable bits (env vars, with defaults) ------------------------
  # which browser to pull cookies from. you're on firefox nightly now, so you
  # may want YTGRAB_BROWSER=firefox — left as vivaldi to match your original.
  local browser="${YTGRAB_BROWSER:-vivaldi}"

  # where files land. default to $PWD so single grabs stay where you are,
  # but you can point this at your ISO-8601 tree for batch runs.
  local outdir="${YTGRAB_OUTDIR:-.}"

  # download-archive: yt-dlp records every grabbed id here and SKIPS them on
  # re-runs. this is the "never re-fetch what i already have" instinct, same
  # as your seedbox/backup discipline. safe to share across all your grabs.
  local archive="${YTGRAB_ARCHIVE:-$HOME/.local/share/pixiekat/ytgrab-archive.txt}"
  mkdir -p "$(dirname "$archive")"   # make sure the dir exists first

  # --- format selection (replaces the old -F + awk scraping) --------------
  # yt-dlp's own selector language does what the awk did, but robustly:
  #   bv*[height<=N][ext=mp4]+ba[ext=m4a]  ideal: mp4 video <=ceiling + m4a audio
  #   /bv*[height<=N]+ba                   fallback: any video <=ceiling + any audio
  #   /b[height<=N]                        fallback: best PRE-MUXED stream <=ceiling
  #   /b                                   last resort: best anything (rare/old uploads)
  # the '/' is yt-dlp's "try-left-then-right" operator — graceful degradation
  # expressed as a format string. [height<=480] is ANCHORED so 480 can never
  # accidentally match inside "1080" the way the old substring regex could.
  #local fmt="bv*[height<=${res}][ext=mp4]+ba[ext=m4a]/bv*[height<=${res}]+ba/b[height<=${res}]/b"
  local fmt="bv*[height<=${res}][vcodec^=avc1]+ba[ext=m4a]/bv*[height<=${res}]+ba/b[height<=${res}]/b"

  # --- the grab -----------------------------------------------------------
  # throttle flags keep us a polite scraper (essential once you loop over many
  # ids): jittered sleeps look less robotic than a fixed delay.
  #   --sleep-requests   pause between metadata/API calls
  #   --sleep-interval / --max-sleep-interval   RANDOM pause between downloads
  # sidecars (--write-info-json / --write-thumbnail) preserve the uploader's
  # description + poster frame — for archive uploads the real date/context
  # often lives in that description, so it's worth keeping their cataloging.
  yt-dlp \
    -f "$fmt" \
    --cookies-from-browser "$browser" \
    --download-archive "$archive" \
    --write-subs --no-write-auto-subs --sub-lang "en.*" \
    --write-info-json --write-thumbnail \
    --sleep-requests 1.5 \
    --sleep-interval 5 --max-sleep-interval 15 \
    -o "$outdir/%(title)s [%(upload_date>%Y-%m-%d)s - %(id)s].%(ext)s" \
    "$url"
}

# dotfiles installation and updates
pixiekat-dotfiles-init() {
  # if ~/webdev/projects exists then we assume we're on a local machine and want to clone to ~/webdev/projects/codeberg/pixiekat/dotfiles to keep it separate from the home directory and avoid accidentally messing with it, but if that path doesn't exist we assume we're on the server and clone directly to ~/dotfiles
  if [ -d "$HOME/webdev/projects" ]; then
    dotfiles_dir="$HOME/webdev/projects/codeberg/pixiekat/dotfiles"
  else
    dotfiles_dir="$HOME/dotfiles"
  fi

  if [ -d "$dotfiles_dir" ]; then
    echo "dotfiles already exists, aborting!"
    return 1
  fi
  git clone https://codeberg.org/pixiekat/dotfiles "$dotfiles_dir"
  cd "$dotfiles_dir"
  git submodule update --init --recursive
  "$dotfiles_dir/install.sh"
}

pixiekat-dotfiles-update() {
  # save the current directory so we can return to it later
  local current_dir=$(pwd)

  cd "$(_pixiekat_resolve_dotfiles_dir)"
  git pull

  # return to the original directory
  cd "$current_dir"
}

pixiekat-dotfiles-submodule-update() {
  # save the current directory so we can return to it later
  local current_dir=$(pwd)

  cd "$(_pixiekat_resolve_dotfiles_dir)"
  git submodule update --init --recursive

  # return to the original directory
  cd "$current_dir"
}

pixiekat-dotfiles-link() {
  $(_pixiekat_resolve_dotfiles_dir)/bin/install-dotfiles.sh
}

pixiekat-dotfiles-rename-master-branch() {
    # save the current directory so we can return to it later
    local current_dir=$(pwd)

    cd "$(_pixiekat_resolve_dotfiles_dir)"
    git branch -m master main

    # return to the original directory
    cd "$current_dir"
}

# Ensure the media group (which includes jellyfin) can read/write/execute in the
# media folders, and that newly created files there inherit the same group.
#
# Usage:
#   pixiekat-dotfiles-set-permissions-on-media-folders            # apply changes
#   pixiekat-dotfiles-set-permissions-on-media-folders --dry-run  # show what WOULD change
#
# How it works:
#   - chown  : hands ownership to $user:media so the group is right
#   - g+rws on dirs : r/w/x for the group, PLUS setgid ("s") so anything created
#                     inside inherits the media group instead of the creator's
#                     default group. This is the bit that stops new downloads
#                     being invisible to Jellyfin.
#   - g+rw on files : existing files become group readable/writable
pixiekat-dotfiles-set-permissions-on-media-folders() {
    local -a media_paths=(
        "/mnt/storage/media/libraries/films"
        "/mnt/storage/media/libraries/tv_shows"
        "/mnt/ata-TOSHIBA_DT01ACA200_96FA2MUAS/Media/TV Series"
        "/mnt/ata-TOSHIBA_DT01ACA200_96FA2MUAS/Media/Movies"
        "/mnt/ata-WDC_WD80EDAZ-11CEWB0_WD-RD1ZAG5H-part1/Media/Movies"
        "/mnt/ata-WDC_WD80EDAZ-11CEWB0_WD-RD1ZAG5H-part1/Media/TV Series"
    )

    # --- parse args -------------------------------------------------------
    # A simple flag check. Kept loose on purpose: any of these spellings works.
    local dry_run=0
    case "$1" in
        --dry-run|-n|--dryrun) dry_run=1 ;;
        "") ;;  # no args is the normal case
        *) echo "Unknown option: $1 (use --dry-run or no arguments)"; return 2 ;;
    esac

    # --- sanity checks ----------------------------------------------------
    if ! getent group media > /dev/null; then
        echo "Media group does not exist, skipping permission setting for media folders."
        return 1
    fi

    local user="$(whoami)"

    if (( dry_run )); then
        echo "=== DRY RUN: nothing will be changed ==="
    fi

    for media_path in "${media_paths[@]}"; do

        if [ ! -d "$media_path" ]; then
            echo "Warning: Path $media_path does not exist, skipping permission setting for this path."
            continue
        fi

        # Warn about filesystems that ignore chmod/chown entirely (NTFS, exFAT,
        # FAT). On those, permissions come from fstab mount options (uid=, gid=,
        # umask=) and this function is a no-op — better to know than to wonder.
        local fstype
        fstype="$(findmnt -no FSTYPE --target "$media_path" 2>/dev/null)"
        case "$fstype" in
            ntfs|ntfs3|fuseblk|exfat|vfat|msdos)
                echo "Warning: $media_path is on $fstype, which ignores chmod/chown."
                echo "         Set permissions via fstab mount options instead. Skipping."
                continue
                ;;
        esac

        echo "Setting permissions for $media_path  (fstype: ${fstype:-unknown})"

        # --- find only what actually needs changing -----------------------
        # ! -perm -g+s  = "does NOT already have the setgid bit"
        # ! -perm -g+w  = "is NOT already group-writable"
        # Filtering like this means repeat runs are cheap: on an already-correct
        # library, find matches nothing and no chmod is executed at all. Without
        # it, chmod rewrites every inode on multi-TB drives on every single run.
        #
        # -print is used in dry-run mode so you see the actual paths that would
        # change, rather than a summary you have to trust.
        if (( dry_run )); then
            echo "  [dry-run] would: sudo chown -R $user:media \"$media_path\""

            local dir_count file_count
            dir_count="$(sudo find "$media_path" -type d ! -perm -g+s -printf '.' 2>/dev/null | wc -c)"
            file_count="$(sudo find "$media_path" -type f ! -perm -g+w -printf '.' 2>/dev/null | wc -c)"

            echo "  [dry-run] would chmod g+rws on $dir_count director(ies) missing setgid"
            echo "  [dry-run] would chmod g+rw  on $file_count file(s) not group-writable"

            # Uncomment to list the individual paths instead of just counting:
            # sudo find "$media_path" -type d ! -perm -g+s -print
            # sudo find "$media_path" -type f ! -perm -g+w -print
        else
            sudo chown -R "$user":media "$media_path"

            # sudo on the finds too, so a file owned by another account (e.g. a
            # download client running as its own user) doesn't cause chmod to
            # error out partway through.
            sudo find "$media_path" -type d ! -perm -g+s -exec chmod g+rws {} +
            sudo find "$media_path" -type f ! -perm -g+w -exec chmod g+rw {} +
        fi
    done

    if (( dry_run )); then
        echo "=== DRY RUN complete — re-run without --dry-run to apply ==="
    fi
}

winget() {
    distro=$(grep -sm1 '^DISTRIB_ID=' /etc/*-release | cut -d= -f2 | tr '[:upper:]' '[:lower:]')

    # fallback for distros that don't use lsb-release
    if [[ -z "$distro" && -f /etc/os-release ]]; then
        . /etc/os-release
        distro=$(echo "$ID" | tr '[:upper:]' '[:lower:]')
    fi

    # ID is ubuntu, so sniff the description string instead
    desc=$(grep -sm1 '^DISTRIB_DESCRIPTION=' /etc/lsb-release | cut -d= -f2- | tr -d '"')
    case "${desc,,}" in
        *"hannah montana"*) distro=hannahmontana ;;
        *uwuntu*)           distro=uwuntu ;;
    esac

    trap '' SIGINT EXIT

    case "$distro" in
        arch)           msg="i use arch btw" ;;
        gentoo)         msg="please wait, compiling winget from source" ;;
        nixos)          msg="have you considered declaring winget functionally" ;;
        fedora)         msg="cutting edge except when it isnt" ;;
        redhat|rhel)    msg="oh fuck off" ;;
        mariner)        msg="lol u playing" ;;
        slackware)      msg="lets get you to bed grandma" ;;
        ubuntu)         msg="thanos should snap u out of existance" ;;
        debian)         msg="shout out to all the hrt girlies ✨" ;;
        linuxmint)      msg="no canonical, no snap, no winget as it should be" ;;
        hannahmontana)  msg="honestly based no judgement here" ;;
        uwuntu)         msg="👉️👈️🥺" ;;
        void)           msg="runit is your personality trait" ;;
        templeos)       msg="this is above my pay grade" ;;
        redstaros)      msg="comrade please step away from the keyboard" ;;
        manjaro)        msg="arch but with drama" ;;
        alpine)         msg="musl enjoyer detected" ;;
        *)              msg="are you mad microsoft on ${distro}??" ;;
    esac

    while true; do
        echo "${msg}"

        if [[ $distro == "hannahmontana" ]]; then
            return 1
        fi
        sleep 0.5
    done
}

pixiekat-claude-install() {
    if [ -x "$(command -v claude)" ]; then
        echo "Claude is already installed, aborting!"
        return 1
    fi
    echo "Installing Claude CLI..."
    curl -fsSL https://claude.ai/install.sh | bash
}

pixiekat-claude-uninstall() {
    if [ ! -x "$(command -v claude)" ]; then
        echo "Claude CLI is not installed, aborting!"
        return 1
    fi
    echo "Uninstalling Claude CLI..."
    rm -f ~/.local/bin/claude
    rm -rf ~/.local/share/claude
    rm -rf ~/.claude

    if [ -f ~/.claude.json ]; then
        rm ~/.claude.json
    fi
}
