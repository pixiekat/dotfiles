# helper function to resolve a service name to a docker compose directory
_pixiekat_dc_resolve_dir() {
  local service=$1
  case $service in
    mailpit)  echo "mailpit" ;;
    rustdesk) echo "rustdesk-server-docker" ;;
    ollama)   echo "ollama" ;;
    *) echo "Unknown service: $service" >&2; return 1 ;;
  esac
}

_pixiekat_resolve_dotfiles_dir() {
  # return the path to the dotfiles directory
  # if ~/webdev/projects exists then we assume we're on a local machine and want to clone to ~/webdev/projects/codeberg/pixiekat/dotfiles to keep it separate from the home directory and avoid accidentally messing with it, but if that path doesn't exist we assume we're on the server and clone directly to ~/dotfiles
  if [ -d "$HOME/webdev/projects" ]; then
    dotfiles_dir="$HOME/webdev/projects/codeberg/pixiekat/dotfiles"
  else
    dotfiles_dir="$HOME/dotfiles"
  fi
  echo "Resolved dotfiles directory: $dotfiles_dir" >&2
  echo "$dotfiles_dir"
}

# helper function to resolve php version and doctrine command for the doctrine aliases
_pixiekat_doctrine_preflight() {
  # if --help or --usage is passed, show usage and exit
  if [[ "$1" == "--help" || "$1" == "--usage" ]]; then
    echo "Usage: $2 [php_command]"
    echo "Example: $2 php8.3"
    return 1  # use 1 so callers can check with || return 0
  fi
  # validate the php command exists before running
  if [ ! -x "$(command -v ${3:-$(command -v php)})" ]; then
    echo "PHP command not found: $3"
    return 1
  fi
  # check we're in a symfony project
  if [ ! -f bin/console ]; then
    echo "No bin/console here — are you in a Symfony project?"
    return 1
  fi
}

# adds a given site to vpn-exclusions.txt on the local network filterlist. Usage: pixiekat-add-vpn-exclusion example.com
# use to quickly add a site without having to add -> commit -> push to the filterlist repo then pull on the server
pixiekat-add-vpn-exclusion() {
  if [ -z "$1" ]; then
    echo "Usage: pixiekat-add-vpn-exclusion example.com"
    return 1
  fi
  # also worth checking the file exists before appending
  if [ ! -f /var/www/html/filterlists/vpn-exclusions.txt ]; then
    echo "VPN exclusions file not found."
    return 1
  fi

  echo "$1" | sudo tee -a /var/www/html/filterlists/vpn-exclusions.txt > /dev/null
  echo "Added $1 to VPN exclusions."
}

# doctrine functions
pixiekat-doctrine-dump-sql() {
  _pixiekat_doctrine_preflight "$1" "doctrine-dump-sql" || return 1

  # get the current cli php version as a local which which php
  local default_php_cmd=$(which php)

  # use the current cli php by default unless argument is provided
  local php_cmd="${1:-$default_php_cmd}"

  # run the doctrine force command with the specified or default php command
  $php_cmd bin/console doctrine:schema:update --complete --dump-sql
}

pixiekat-doctrine-force() {
  _pixiekat_doctrine_preflight "$1" "doctrine-force" || return 1

  # get the current cli php version as a local which which php
  local default_php_cmd=$(which php)

  # use the current cli php by default unless argument is provided
  local php_cmd="${1:-$default_php_cmd}"

  # run the doctrine force command with the specified or default php command
  $php_cmd bin/console doctrine:schema:update --force
}

# docker compose functions
pixiekat-dcup() {
  local dir
  dir=$(_pixiekat_dc_resolve_dir "$1") || return 1
  docker compose -f ~/webdev/projects/docker/$dir/docker-compose.yml up -d
}

pixiekat-dcdown() {
  local dir
  dir=$(_pixiekat_dc_resolve_dir "$1") || return 1
  docker compose -f ~/webdev/projects/docker/$dir/docker-compose.yml down
}

pixiekat-dcstop() {
  local dir
  dir=$(_pixiekat_dc_resolve_dir "$1") || return 1
  docker compose -f ~/webdev/projects/docker/$dir/docker-compose.yml stop
}

pixiekat-dcstart() {
  local dir
  dir=$(_pixiekat_dc_resolve_dir "$1") || return 1
  docker compose -f ~/webdev/projects/docker/$dir/docker-compose.yml start
}

pixiekat-dcpull() {
  local dir
  dir=$(_pixiekat_dc_resolve_dir "$1") || return 1
  docker compose -f ~/webdev/projects/docker/$dir/docker-compose.yml pull
}

