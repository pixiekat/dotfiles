{
    "policies": {
        "AIControls": {
            "Default": {
                "Value": "blocked",
                "Locked": true
            },
            "Translations": {
                "Value": "available",
                "Locked": true
            }
        },
        "FirefoxSuggest": {
            "WebSuggestions": true,
            "SponsoredSuggestions": false,
            "ImproveSuggest": false,
            "Locked": true
        },
        "SearchEngines": {
            "Default": "DuckDuckGo - NoAI",
            "Remove": ["Perplexity", "Google", "Bing", "eBay", "Amazon.com"],
            "Add": [
                {
                    "Name": "Codeberg",
                    "URLTemplate": "https://codeberg.org/explore/repos?q={searchTerms}",
                    "Method": "GET",
                    "IconURL": "data:image/png;base64,",
                    "Alias": "cb"
                },
                {
                    "Name": "Github",
                    "URLTemplate": "https://github.com/search?q={searchTerms}&type=repositories",
                    "Method": "GET",
                    "IconURL": "data:image/png;base64,",
                    "Alias": "gh"
                },
                {
                    "Name": "DuckDuckGo - NoAI",
                    "URLTemplate": "https://noai.duckduckgo.com/?ia=web&t=h_&q={searchTerms}",
                    "Method": "GET",
                    "IconURL": "data:image/x-icon;base64,",
                    "Alias": "ddgnoai"
                },
                {
                    "Name": "Mu.social",
                    "URLTemplate": "https://mu.social/search?q={searchTerms}",
                    "Method": "GET",
                    "IconURL": "data:image/png;base64,",
                    "Alias": "mu"
                },
                {
                    "Name": "Kagi",
                    "URLTemplate": "https://kagi.com/search?q={searchTerms}&from_date=&to_date=&verbatim=1&personalized=1",
                    "Method": "GET",
                    "IconURL": "data:image/png;base64,",
                    "Alias": "kagi"
                },
                {
                    "Name": "Wowpedia",
                    "URLTemplate": "https://warcraft.wiki.gg/wiki/Special:Search?search={searchTerms}&go=Go&ns0=1",
                    "Method": "GET",
                    "IconURL": "https://warcraft.wiki.gg/images/Site-favicon.ico?953eeb",
                    "Alias": "wowpedia"
                },
                {
                    "Name": "Wowhead",
                    "URLTemplate": "https://www.wowhead.com/search?q={searchTerms}",
                    "Method": "GET",
                    "IconURL": "data:image/png;base64,",
                    "Alias": "wowhead"
                },
                {
                    "Name": "/r/simpsons search",
                    "URLTemplate": "https://noai.duckduckgo.com/?q=site%3Areddit.com%2Fr%2Fthesimpsons+{searchTerms}&ia=web",
                    "Method": "GET",
                    "Alias": "rsimpsons"
                },
                {
                    "Name": "OpenSubtitles",
                    "URLTemplate": "https://www.opensubtitles.org/en/search2/moviename-{searchTerms}/sublanguageid-eng/hearingimpaired-on/hd-on",
                    "Method": "GET",
                    "Alias": "opensubs"
                },
                {
                    "Name": "TvDB",
                    "URLTemplate": "https://thetvdb.com/search?query={searchTerms}",
                    "Method": "GET",
                    "Alias": "tvdb"
                }
            ]
        }
    }
}
